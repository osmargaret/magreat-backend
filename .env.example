# Server
PORT=5000
NODE_ENV=development

# Cloudinary (required — get from cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin auth (required — generate a strong random string, e.g. openssl rand -hex 32)
ADMIN_SECRET=change_me_to_a_strong_random_secret

# Database (required in production — Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email / SMTP (Mailtrap live SMTP or standard SMTP for newsletter broadcast & alerts)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=your_mailtrap_token
ADMIN_EMAIL=hello@magreattaste.ng
MAIL_SENDER_NAME=Margaret O.
